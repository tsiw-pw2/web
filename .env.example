# Nome da app no título do browser (ex.: "Campanhas · Mariva")
VITE_APP_NAME=Mariva
# Contactos legais (páginas /ajuda, /privacidade, pedido de organizador)
VITE_SUPPORT_EMAIL=support@mariva.com
VITE_PRIVACY_EMAIL=

# Desenvolvimento: vazio = proxy Vite (ver VITE_DEV_API_PORT). Pedidos a /sessions, /users, /dashboard, … vão para a API local.
# Opcional: URL absoluta da API, ex.: http://127.0.0.1:3000
VITE_API_URL=
# Porta da API no proxy do Vite (deve coincidir com PORT no api/.env)
VITE_DEV_API_PORT=3000
